# Packaging manifest for the BigWigs/CurseForge packager.
# Libraries stay vendored under libs/ — no externals are pulled.

package-as: PrettyChat

enable-nolib-creation: no

ignore:
  - .luacheckrc
  - .gitignore
  - .gitattributes
  - docs        # holds docs/audits/ and docs/reviews/ too — all dev-only
  - tests
  - _dev
  - "*.bak"

  # Generated reference data — the WHOLE folder, source dump, 26 chunks,
  # splitter and all. Nothing in the addon loads it: PrettyChat.toc dropped the
  # chunk list once the settings panel started reading this client's OnEnable
  # snapshot instead (PC-R-04/PC-R-05), which had the client parsing 1.89 MB and
  # 22,879 entries at every login to serve zero lookups. What is left is repo
  # reference data that tests/test_defaults.lua loads directly to check every
  # override against Blizzard's real signature — dev-only, like docs/ and tests/.
  - GlobalStrings

  # Project-page art, served from the CurseForge CDN — never downloaded by a
  # player. Only the .tga logo is loadable at runtime (settings/Panel.lua);
  # WoW cannot read .png or .jpg at all, so the master .png and the .jpg
  # render exist purely for the project page and for regenerating the .tga.
  - media/screenshots
  - media/logos/*.png
  - media/logos/*.jpg
