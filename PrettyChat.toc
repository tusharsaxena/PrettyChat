# Libraries (must load first)
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\LibKa0s\LibKa0s.xml

# Locales (locale table — no earlier-load dependency; toc-file-§5 section order)
locales\enUS.lua

# Core (the LibKa0s seams load first)
# core\EnvSetup.lua loads BEFORE core\Namespace.lua and the position is load-bearing:
# Namespace, settings\Panel.lua and settings\Slash.lua ALL read the TOC at FILE SCOPE, so the
# seam has to exist before them. Each of those reads resolves once, at load, and keeps the
# answer for the whole session. They call the seam UNGUARDED, deliberately: a seam published
# later raises here and now rather than leaving a version silently pinned to a literal.
core\EnvSetup.lua
# core\MediaSetup.lua loads BEFORE core\Constants.lua and the position is load-bearing:
# Constants resolves FONT_MONO through NS.MediaFont at load, so the seam must be published first.
core\MediaSetup.lua
core\Constants.lua
core\Namespace.lua
core\State.lua
core\Util.lua
core\Database.lua
core\PrettyChat.lua
core\CoreSetup.lua
core\DebugLogSetup.lua

# Defaults (data tables — must precede settings\Schema.lua)
defaults\Profile.lua
defaults\Defaults.lua

# Modules (the override pipeline)
modules\Override.lua

# Settings (last — depend on everything else being initialized)
settings\Schema.lua
settings\OptionsSetup.lua
settings\Slash.lua
settings\Panel.lua
